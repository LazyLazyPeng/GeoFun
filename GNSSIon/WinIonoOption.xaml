<Window x:Class="GNSSIon.WinIonoOption"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GNSSIon"
        mc:Ignorable="d"
        FontSize="14"
        WindowStyle="ToolWindow"
        Title="电离层解算设置" Height="393" Width="709">
    <Window.DataContext>
        <local:IonoOptionViewModel/>
    </Window.DataContext>
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="5 5 15 5"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="BorderBrush" Value="Black"></Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
        <Style x:Key="HeaderLabel" TargetType="Label">
            <Setter Property="Width" Value="100"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="HorizontalContentAlignment" Value="Center"></Setter>
            <Setter Property="Background" Value="AntiqueWhite"></Setter>
        </Style>
        <Style TargetType="StackPanel">
            <Setter Property="VerticalAlignment" Value="Top"></Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"></Setter>
            <Setter Property="Padding" Value="5"></Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"></BooleanToVisibilityConverter>
    </Window.Resources>
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal">
            <Label Width="100">待解算文件夹</Label>
            <TextBox Name="tbxFolderIn" MinWidth="550" Margin="5"
                     Text="{Binding RootFolder,UpdateSourceTrigger=PropertyChanged}"></TextBox>
            <Button Name="btnOpenFolder" Click="btnOpenFolder_Click" FontSize="14" Margin="5 5" Padding="5 0">...</Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Label Style="{StaticResource HeaderLabel}">解算类型:</Label>
            <RadioButton VerticalAlignment="Center" Margin="5 0" IsChecked="True"
                         Name="singleStation">单站单天解</RadioButton>
            <RadioButton VerticalAlignment="Center" Margin="5 0"
                         Name="multiStations">多站单天解</RadioButton>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" 
                    Visibility="{Binding ElementName=multiStations, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Label Style="{StaticResource HeaderLabel}">是否估算DCB</Label>
                <RadioButton VerticalAlignment="Center" Margin="5 0" IsChecked="True">是</RadioButton>
                <RadioButton VerticalAlignment="Center" Margin="5 0">否</RadioButton>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                    Visibility="{Binding ElementName=multiStations, Path=IsChecked, Converter={StaticResource BoolToVis}}">
                <Label Style="{StaticResource HeaderLabel}">模型选择:</Label>
                <RadioButton Name="rbSpheric" VerticalAlignment="Center" Margin="5 0">球谐函数</RadioButton>
                <RadioButton Name="rbPolynominal" VerticalAlignment="Center" Margin="5 0">多项式</RadioButton>


            </StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Label Style="{StaticResource HeaderLabel}">截止高度角(°):</Label>
            <TextBox Name="tbxCutOffAngle" MinWidth="30" VerticalAlignment="Center">30</TextBox>
            <Label Style="{StaticResource HeaderLabel}"
                   Margin="20 5 5 5">最短弧长(历元):</Label>
            <TextBox Name="tbxMinArcLength" MinWidth="50" VerticalAlignment="Center" HorizontalContentAlignment="Center">30</TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Label Style="{StaticResource HeaderLabel}">输出参数:</Label>
            <CheckBox Name="chkIPPB" IsChecked="True">穿刺点经度</CheckBox>
            <CheckBox Name="chkIPPL" IsChecked="True">穿刺点纬度</CheckBox>
            <CheckBox Name="chkSTEC" IsChecked="True">STEC</CheckBox>
            <CheckBox Name="chkVTEC" IsChecked="True">VTEC</CheckBox>
            <CheckBox Name="chkDDTEC">dTEC</CheckBox>
            <CheckBox Name="chkROTI">ROTI</CheckBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Name="btnOK" Click="Button_Click">确定</Button>
            <Button Name="btnCancel" Click="btnCancel_Click">取消</Button>
        </StackPanel>
        <Grid>
        </Grid>

    </StackPanel>
</Window>
